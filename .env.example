# Postgres (Supabase: dùng connection string "Session pooler" hoặc "Direct")
DATABASE_URL=postgresql://booking:booking@127.0.0.1:5441/booking_hub

# Ký cookie phiên đăng nhập. Tạo bằng: openssl rand -base64 32
AUTH_SECRET=

# Lark app (open.larksuite.com > Developer Console > app > Credentials)
LARK_APP_ID=
LARK_APP_SECRET=
LARK_DOMAIN=open.larksuite.com
# Tùy chọn: chỉ cho tài khoản thuộc tenant này đăng nhập
LARK_TENANT_KEY=
# Lark User ID được tự tạo làm Admin ở lần đăng nhập đầu (cách nhau dấu phẩy)
ADMIN_LARK_IDS=
