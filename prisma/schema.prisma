datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN  // quản lý user + toàn quyền
  LEADER // sửa mọi booking & danh bạ
  STAFF  // sửa booking mình phụ trách, xem danh bạ
}

model User {
  id          String    @id @default(cuid())
  larkUserId  String    @unique // user_id (hoặc open_id ou_...) của tài khoản Lark
  // Lấy từ Lark khi Admin thêm user và mỗi lần đăng nhập, không sửa tay.
  name        String?
  email       String?
  avatarUrl   String?
  department  String?
  jobTitle    String?
  role        Role      @default(STAFF)
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  kocs        Koc[]
  listingBatches ListingBatch[]
  listingItems   ListingItem[]
  kocNotes       KocNote[]
}

model Koc {
  id         String   @id @default(cuid())
  platform   String   @default("TikTok")
  handle     String   // @username, không gồm @
  name       String   // tên kênh
  channelUrl String?
  followers  Int?
  niche      String?  // tệp kênh
  phone      String?
  zalo       String?
  email      String?
  rateCard   Int?     // giá tham khảo / video, VND
  note       String?
  picId      String?
  pic        User?    @relation(fields: [picId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Chỉ số 30 ngày từ TikTok Shop Creator Marketplace (src/lib/creatorStats.ts). followers cũng được cập nhật từ đây.
  ttsOpenId    String?   // creator_open_id; null + ttsCheckedAt có giá trị = không có trên Marketplace
  ttsCheckedAt DateTime?
  statsAt      DateTime?
  nickname     String?
  avgViews     Int?      // lượt xem TB / video bán hàng
  avgLiveViews Int?      // lượt xem TB / LIVE bán hàng
  unitsSold    Int?      // số món bán
  gmvRange     String?   // TikTok VN chỉ trả khoảng, vd "1M₫+"
  gpmUsd       Float?    // GMV / 1.000 lượt xem, USD
  creatorLevel Int?
  avatarUrl    String?
  ttsProfile   Json?     // hồ sơ creator nguyên văn: chân dung follower, tỷ trọng GMV theo kênh / ngành...

  kl           String?   // cấp KOL KL1–KL7 nhập tay; trống thì dùng klAuto
  // Gộp từ booking trên Lark mỗi lượt đồng bộ (refreshKocAggregates)
  klAuto        String?
  bookingCount  Int       @default(0)
  lastBookingAt DateTime?
  // Nhận hàng mẫu
  receiverName  String?
  receiverPhone String?
  address       String?
  // Thanh toán: chỉ Admin / Leader xem, không bao giờ xuất cho Brand
  bankHolder    String?
  bankAccount   String?
  bankName      String?
  idNumber      String?  // CCCD / MST

  listingItems ListingItem[]
  snapshots    KocSnapshot[]
  notes        KocNote[]

  @@unique([platform, handle])
  @@index([niche])
  @@index([followers])
  @@index([unitsSold])
}

// Bản sao chỉ đọc của bảng "3.2 List duyệt book" trên Lark Base, đồng bộ mỗi giờ (src/lib/bookingSync.ts).
model Booking {
  id            String    @id // record_id trên Lark
  code          String    // Mã Booking (BO...)
  channel       String?   // 🎃 id kênh
  channelUrl    String?
  store         String?
  brand         String?
  owner         String?   // Người phụ trách
  pipeline      String?
  planMonth     String?   // "2026/03"
  airDate       DateTime? // Ngày air/live real
  planAirDate   DateTime? // P.Ngày air
  cost          Float?    // Chi phí thanh toán Booking, VND
  linkAir       String?
  slaLate       Boolean   @default(false) // Lark "Cảnh báo trễ SLA" = Trễ hạn
  paymentStatus String?   // Trạng thái phiếu thanh toán (Under Review, Rejected...)
  planShipDate     DateTime?
  planReceiveDate  DateTime?
  planScriptDate   DateTime?
  planDemoDate     DateTime?
  planPaymentDate  DateTime? // P.Ngày làm ĐNTT
  bookingPic    String?
  accountPic    String?
  leader        String?
  syncVersion   Int       @default(0)
  extra         Json      // các cột phụ: sản phẩm, tệp kênh, nền tảng, KL, views/GMV 30 ngày...
  larkUpdatedAt DateTime  // last_modified_time của Lark, để chỉ ghi bản ghi mới/đã sửa
  syncedAt      DateTime  @updatedAt

  @@index([planMonth])
  @@index([brand])
  @@index([pipeline])
  @@index([owner])
  @@index([code])
  @@index([slaLate])
  @@index([airDate])
  @@index([planAirDate])
}

model SyncState {
  id         String    @id // "bookings"
  startedAt  DateTime?
  finishedAt DateTime?
  message    String?
  data       Json? // kết quả job, vd. thống kê tab Dữ liệu
}

// Đợt listing: danh sách KOC đề xuất cho Brand duyệt (thay file "Excel Listing").
model ListingBatch {
  id          String        @id @default(cuid())
  name        String        // "pH Care – T11 – Đợt 1"
  brand       String?
  store       String?
  product     String?
  month       String        // "2026-11"
  cr          Float?        // tỷ lệ chuyển đổi SP theo gian hàng, 0.05 = 5%
  aov         Int?          // AOV sản phẩm theo gian hàng, VND
  shareToken  String?       // link Brand duyệt /review/<token>; null = chưa tạo hoặc đã thu hồi. Index thường, không @unique: thêm unique
                            // vào bảng có sẵn khiến `prisma db push` trên Render dừng đòi --accept-data-loss; token ngẫu nhiên 144 bit.
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  items       ListingItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([month])
  @@index([shareToken])
}

// Một KOC trong đợt listing. Số liệu kênh (follower, GPM, chân dung...) đọc trực tiếp từ Koc, không chép vào đây.
model ListingItem {
  id             String       @id @default(cuid())
  batchId        String
  batch          ListingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  kocId          String
  koc            Koc          @relation(fields: [kocId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  priceType      String       @default("Video")
  price          Int?         // giá net đề xuất cho đợt này, VND
  status         String?      // trạng thái liên hệ
  recommendation String?      // Must Have / Recommend / Optional
  contentNote    String?
  brandChoice    String?      // Yes / No / Cân nhắc
  rejectReason   String?
  planAirDate    DateTime?
  viewTarget     Int?         // nhập tay khi cần (KL6–KL7, hoặc chưa có số TikTok)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([batchId, kocId])
}

// Hiệu quả của từng KOL Danh bạ trong từng bảng của Trạm dữ liệu (tab Dữ liệu, hồ sơ KOC).
// m theo thứ tự chỉ số của nguồn trong src/lib/dataSources.ts. Job data-sources ghi đè cả nguồn mỗi lần chạy.
model CreatorMetric {
  source    String
  handle    String
  m         Float[]
  updatedAt DateTime @default(now())

  @@id([source, handle])
  @@index([handle])
}

// Chỉ số Creator Marketplace mỗi lần tra thành công, để xem xu hướng (src/lib/creatorStats.ts).
model KocSnapshot {
  id           String   @id @default(cuid())
  kocId        String
  koc          Koc      @relation(fields: [kocId], references: [id], onDelete: Cascade)
  at           DateTime @default(now())
  followers    Int?
  avgViews     Int?
  avgLiveViews Int?
  unitsSold    Int?
  gmvRange     String?
  gpmUsd       Float?

  @@index([kocId, at])
}

// Nhật ký chăm sóc KOL; followUpAt = hẹn liên hệ lại, doneAt = đã xử lý hẹn.
model KocNote {
  id         String    @id @default(cuid())
  kocId      String
  koc        Koc       @relation(fields: [kocId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  followUpAt DateTime?
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([kocId, createdAt])
  @@index([followUpAt])
}
