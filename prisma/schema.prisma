datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN  // quản lý user + toàn quyền
  LEADER // sửa mọi booking & danh bạ
  STAFF  // sửa booking mình phụ trách, xem danh bạ
}

model User {
  id          String    @id @default(cuid())
  larkUserId  String    @unique // user_id (hoặc open_id ou_...) của tài khoản Lark
  // Lấy từ Lark khi Admin thêm user và mỗi lần đăng nhập, không sửa tay.
  name        String?
  email       String?
  avatarUrl   String?
  department  String?
  jobTitle    String?
  role        Role      @default(STAFF)
  jobRole     String?   // vai trò nghiệp vụ: Trưởng phòng / Booking PIC / Booking Support / Brand Manager
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  kocs        Koc[]
  listingBatches ListingBatch[]
  listingItems   ListingItem[]
  kocNotes       KocNote[]
  matchBriefs    MatchBrief[]
  brandMembers   BrandMember[]
  planLines      PlanLine[]
  jobs           Job[]
}

model Koc {
  id         String   @id @default(cuid())
  platform   String   @default("TikTok")
  handle     String   // @username, không gồm @
  name       String   // tên kênh
  channelUrl String?
  followers  Int?
  niche      String?  // tệp kênh
  phone      String?
  zalo       String?
  email      String?
  rateCard   Int?     // giá tham khảo / video, VND
  note       String?
  picId      String?
  pic        User?    @relation(fields: [picId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Chỉ số 30 ngày từ TikTok Shop Creator Marketplace (src/lib/creatorStats.ts). followers cũng được cập nhật từ đây.
  ttsOpenId    String?   // creator_open_id; null + ttsCheckedAt có giá trị = không có trên Marketplace
  ttsCheckedAt DateTime?
  statsAt      DateTime?
  nickname     String?
  avgViews     Int?      // lượt xem TB / video bán hàng
  avgLiveViews Int?      // lượt xem TB / LIVE bán hàng
  unitsSold    Int?      // số món bán
  gmvRange     String?   // TikTok VN chỉ trả khoảng, vd "1M₫+"
  gpmUsd       Float?    // GMV / 1.000 lượt xem, USD
  creatorLevel Int?
  avatarUrl    String?
  ttsProfile   Json?     // hồ sơ creator nguyên văn: chân dung follower, tỷ trọng GMV theo kênh / ngành...

  kl           String?   // cấp KOL KL1–KL7 nhập tay; trống thì dùng klAuto
  // Gộp từ booking trên Lark mỗi lượt đồng bộ (refreshKocAggregates)
  klAuto        String?
  bookingCount  Int       @default(0)
  lastBookingAt DateTime?
  // Nhận hàng mẫu
  receiverName  String?
  receiverPhone String?
  address       String?
  // Thanh toán: chỉ Admin / Leader xem, không bao giờ xuất cho Brand
  bankHolder    String?
  bankAccount   String?
  bankName      String?
  idNumber      String?  // CCCD / MST

  listingItems ListingItem[]
  snapshots    KocSnapshot[]
  notes        KocNote[]
  jobs         Job[]
  tags            String[] @default([]) // nhãn nội bộ, vd "Giao hàng chậm", "Hợp brand mẹ bé"
  blacklisted     Boolean  @default(false) // không book nữa: ẩn khỏi Creator matching
  blacklistReason String?

  @@unique([platform, handle])
  @@index([niche])
  @@index([followers])
  @@index([unitsSold])
}

// Bản sao chỉ đọc của bảng "3.2 List duyệt book" trên Lark Base, đồng bộ mỗi giờ (src/lib/bookingSync.ts).
model Booking {
  id            String    @id // record_id trên Lark
  code          String    // Mã Booking (BO...)
  channel       String?   // 🎃 id kênh
  channelUrl    String?
  store         String?
  brand         String?
  owner         String?   // Người phụ trách
  pipeline      String?
  planMonth     String?   // "2026/03"
  airDate       DateTime? // Ngày air/live real
  planAirDate   DateTime? // P.Ngày air
  cost          Float?    // Chi phí thanh toán Booking, VND
  linkAir       String?
  slaLate       Boolean   @default(false) // Lark "Cảnh báo trễ SLA" = Trễ hạn
  paymentStatus String?   // Trạng thái phiếu thanh toán (Under Review, Rejected...)
  planShipDate     DateTime?
  planReceiveDate  DateTime?
  planScriptDate   DateTime?
  planDemoDate     DateTime?
  planPaymentDate  DateTime? // P.Ngày làm ĐNTT
  bookingPic    String?
  accountPic    String?
  leader        String?
  syncVersion   Int       @default(0)
  extra         Json      // các cột phụ: sản phẩm, tệp kênh, nền tảng, KL, views/GMV 30 ngày...
  larkUpdatedAt DateTime  // last_modified_time của Lark, để chỉ ghi bản ghi mới/đã sửa
  syncedAt      DateTime  @updatedAt

  @@index([planMonth])
  @@index([brand])
  @@index([pipeline])
  @@index([owner])
  @@index([code])
  @@index([slaLate])
  @@index([airDate])
  @@index([planAirDate])
}

model SyncState {
  id         String    @id // "bookings"
  startedAt  DateTime?
  finishedAt DateTime?
  message    String?
  data       Json? // kết quả job, vd. thống kê tab Dữ liệu
}

// Đợt listing: danh sách KOC đề xuất cho Brand duyệt (thay file "Excel Listing").
model ListingBatch {
  id          String        @id @default(cuid())
  name        String        // "pH Care – T11 – Đợt 1"
  brand       String?
  store       String?
  product     String?
  month       String        // "2026-11"
  cr          Float?        // tỷ lệ chuyển đổi SP theo gian hàng, 0.05 = 5%
  aov         Int?          // AOV sản phẩm theo gian hàng, VND
  planLineId  String?       // đợt tạo từ matching của một dòng plan: job tạo từ đợt này gắn về dòng plan đó
  shareToken  String?       // link Brand duyệt /review/<token>; null = chưa tạo hoặc đã thu hồi. Index thường, không @unique: thêm unique
                            // vào bảng có sẵn khiến `prisma db push` trên Render dừng đòi --accept-data-loss; token ngẫu nhiên 144 bit.
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  items       ListingItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([month])
  @@index([shareToken])
}

// Một KOC trong đợt listing. Số liệu kênh (follower, GPM, chân dung...) đọc trực tiếp từ Koc, không chép vào đây.
model ListingItem {
  job          Job?
  id             String       @id @default(cuid())
  batchId        String
  batch          ListingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  kocId          String
  koc            Koc          @relation(fields: [kocId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  priceType      String       @default("Video")
  price          Int?         // giá net đề xuất cho đợt này, VND
  status         String?      // trạng thái liên hệ
  recommendation String?      // Must Have / Recommend / Optional
  contentNote    String?
  brandChoice    String?      // Yes / No / Cân nhắc
  rejectReason   String?
  planAirDate    DateTime?
  viewTarget     Int?         // nhập tay khi cần (KL6–KL7, hoặc chưa có số TikTok)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([batchId, kocId])
}

// Hiệu quả của từng KOL Danh bạ trong từng bảng của Trạm dữ liệu (tab Dữ liệu, hồ sơ KOC).
// m theo thứ tự chỉ số của nguồn trong src/lib/dataSources.ts. Job data-sources ghi đè cả nguồn mỗi lần chạy.
model CreatorMetric {
  source    String
  handle    String
  m         Float[]
  shops     Json?    // [{ key, shop, m }]: tách theo shop / brand / sản phẩm của nguồn, 20 shop lớn nhất
  updatedAt DateTime @default(now())

  @@id([source, handle])
  @@index([handle])
}

// Chỉ số Creator Marketplace mỗi lần tra thành công, để xem xu hướng (src/lib/creatorStats.ts).
model KocSnapshot {
  id           String   @id @default(cuid())
  kocId        String
  koc          Koc      @relation(fields: [kocId], references: [id], onDelete: Cascade)
  at           DateTime @default(now())
  followers    Int?
  avgViews     Int?
  avgLiveViews Int?
  unitsSold    Int?
  gmvRange     String?
  gpmUsd       Float?

  @@index([kocId, at])
}

// Nhật ký chăm sóc KOL; followUpAt = hẹn liên hệ lại, doneAt = đã xử lý hẹn.
model KocNote {
  id         String    @id @default(cuid())
  kocId      String
  koc        Koc       @relation(fields: [kocId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  followUpAt DateTime?
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([kocId, createdAt])
  @@index([followUpAt])
}

// Creator matching. template = best practice theo ngành hàng (B2C cung cấp); brief = yêu cầu của một brand
// (guideline, content strategy, content plan) + bộ tiêu chí lọc KOC, thường chép từ best practice của ngành.
model MatchBrief {
  id          String   @id @default(cuid())
  name        String
  template    Boolean  @default(false)
  category    String?  // ngành hàng
  brand       String?
  guideline   String?  // Brand guideline: link tài liệu + ghi chú
  strategy    String?  // Content strategy
  plan        String?  // Content plan
  note        String?  // best practice (template) / ghi chú (brief)
  criteria    Json     @default("{}") // src/lib/matching.ts Criteria
  brandId     String?
  brandRef    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  planLineId  String?
  planLine    PlanLine? @relation(fields: [planLineId], references: [id], onDelete: SetNull)
  decisions   MatchDecision[]
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([template, updatedAt])
}

// Bảng xếp hạng tính sẵn cho tab Dữ liệu (job data-sources): trang đọc DB, không hỏi Trạm lúc mở trang.
// kind: "top" (top creator theo từng chỉ số), "shops" (theo shop), "shop:<key>" (top creator của một shop).
model SourceCache {
  source    String
  kind      String
  data      Json
  updatedAt DateTime @default(now())

  @@id([source, kind])
}

// ---------------------------------------------------------------- Master data
model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  logoUrl   String?
  usp       String?  // điểm bán hàng chính
  guideline String?  // brand guideline: link tài liệu + điểm chính (tone, từ cấm, claim được phép)
  checklist String?  // tiêu chí nghiệm thu video, mỗi dòng một tiêu chí; trống = checklist mặc định
  note      String?
  stores    Store[]
  products  Product[]
  members   BrandMember[]
  planLines PlanLine[]
  jobs      Job[]
  briefs    MatchBrief[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store { // gian hàng
  id       String    @id @default(cuid())
  brandId  String
  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name     String
  platform String    @default("TikTok Shop")
  url      String?
  cr       Float?    // tỷ lệ chuyển đổi sản phẩm theo gian hàng, 0.05 = 5%
  aov      Int?      // giá trị đơn trung bình, VND
  products Product[]

  @@unique([brandId, name])
}

model Product {
  id        String     @id @default(cuid())
  brandId   String
  brand     Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  storeId   String?
  store     Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  name      String
  imageUrl  String?
  usp       String?
  price     Int?
  link      String?
  planLines PlanLine[]
  jobs      Job[]
}

model TierPrice { // bảng giá booking theo tier KOC
  id        String  @id @default(cuid())
  tier      String  // KL1–KL7
  priceType String  // Video, Phiên livestream...
  minPrice  Int?
  maxPrice  Int?
  note      String?

  @@unique([tier, priceType])
}

model BrandMember { // nhân sự phụ trách brand
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    String // Booking PIC / Booking Support / Brand Manager

  @@id([brandId, userId, role])
}

// ---------------------------------------------------------------- Plan
model Plan {
  id          String     @id @default(cuid())
  name        String
  month       String     // "2026-12"
  budget      Int?
  note        String?
  createdById String
  lines       PlanLine[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([month])
}

model PlanLine { // plan chi tiết: brand × tuần × tier × loại content
  id          String       @id @default(cuid())
  planId      String
  plan        Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  brandId     String?
  brand       Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  week        Int?         // tuần 1–5 của tháng
  tier        String?      // KL1–KL7
  contentType String       @default("Video")
  quantity    Int          @default(1)
  budget      Int?
  picId       String?
  pic         User?        @relation(fields: [picId], references: [id], onDelete: SetNull)
  note        String?
  briefs      MatchBrief[]
  jobs        Job[]
}

// ---------------------------------------------------------------- Matching
model MatchDecision { // chọn / loại KOC trong một brief; loại bắt buộc có lý do
  briefId  String
  brief    MatchBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  kocId    String
  decision String     // pick | reject
  reason   String?
  byId     String
  at       DateTime   @default(now())

  @@id([briefId, kocId])
}

// ---------------------------------------------------------------- Job (booking quản lý trong app)
model Job {
  id            String          @id @default(cuid())
  number        Int             @unique @default(autoincrement())
  kocId         String
  koc           Koc             @relation(fields: [kocId], references: [id])
  brandId       String?
  brand         Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  productId     String?
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  planLineId    String?
  planLine      PlanLine?       @relation(fields: [planLineId], references: [id], onDelete: SetNull)
  listingItemId String?         @unique
  listingItem   ListingItem?    @relation(fields: [listingItemId], references: [id], onDelete: SetNull)
  picId         String?
  pic           User?           @relation(fields: [picId], references: [id], onDelete: SetNull)
  stage         String          @default("Đã duyệt") // src/lib/jobs.ts STAGES
  priceType     String          @default("Video")
  price         Int?            // giá net
  deadline      DateTime?       // hạn air
  sample        String?         // hàng mẫu: Cần gửi / Đã gửi / KOC đã nhận / Đã hoàn / Không cần
  brief         String?
  briefApproved Boolean         @default(false)
  submittedUrl  String?         // link video KOC nộp
  submittedAt   DateTime?
  review        Json?           // [{ item, result, at, note }] theo checklist nghiệm thu
  reviewResult  String?         // Đạt / Cần sửa / Không đạt
  reviewNote    String?
  reviewedById  String?
  reviewedAt    DateTime?
  paymentId     String?
  payment       PaymentRequest? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  note          String?
  createdById   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([stage])
  @@index([brandId])
  @@index([picId])
}

model PaymentRequest { // đề nghị thanh toán (ĐNTT) gom từ job đã nghiệm thu đạt
  id          String   @id @default(cuid())
  number      Int      @unique @default(autoincrement())
  status      String   @default("Nháp") // Nháp / Đã gửi duyệt / Đã duyệt / Đã thanh toán
  note        String?
  createdById String
  jobs        Job[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog { // lịch sử thay đổi
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  userId   String?
  entity   String   // Job, Plan, Brand...
  entityId String
  action   String
  detail   Json?

  @@index([entity, entityId])
}
