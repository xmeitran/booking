datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN  // quản lý user + toàn quyền
  LEADER // sửa mọi booking & danh bạ
  STAFF  // sửa booking mình phụ trách, xem danh bạ
}

model User {
  id          String    @id @default(cuid())
  larkUserId  String    @unique // user_id (hoặc open_id ou_...) của tài khoản Lark
  // Lấy từ Lark khi Admin thêm user và mỗi lần đăng nhập, không sửa tay.
  name        String?
  email       String?
  avatarUrl   String?
  department  String?
  jobTitle    String?
  role        Role      @default(STAFF)
  jobRole     String?   // vai trò nghiệp vụ: Trưởng phòng / Booking PIC / Booking Support / Brand Manager
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  kocs        Koc[]
  listingBatches ListingBatch[]
  listingItems   ListingItem[]
  kocNotes       KocNote[]
  kocRatings     KocRating[]
  kocReviews     KocReview[]
  matchBriefs    MatchBrief[]
  brandMembers   BrandMember[]
  planLines      PlanLine[]
  jobs           Job[]
}

model Koc {
  id         String   @id @default(cuid())
  platform   String   @default("TikTok")
  handle     String   // @username, không gồm @
  name       String   // tên kênh
  channelUrl String?
  followers  Int?
  niche      String?  // tệp kênh
  phone      String?
  zalo       String?
  email      String?
  rateCard   Int?     // giá tham khảo / video, VND
  note       String?
  picId      String?
  pic        User?    @relation(fields: [picId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Chỉ số 30 ngày từ TikTok Shop Creator Marketplace (src/lib/creatorStats.ts). followers cũng được cập nhật từ đây.
  ttsOpenId    String?   // creator_open_id; null + ttsCheckedAt có giá trị = không có trên Marketplace
  ttsCheckedAt DateTime?
  statsAt      DateTime?
  nickname     String?
  avgViews     Int?      // lượt xem TB / video bán hàng
  avgLiveViews Int?      // lượt xem TB / LIVE bán hàng
  unitsSold    Int?      // số món bán
  gmvRange     String?   // TikTok VN chỉ trả khoảng, vd "1M₫+"
  gpmUsd       Float?    // GMV / 1.000 lượt xem, USD
  creatorLevel Int?
  avatarUrl    String?
  ttsProfile   Json?     // hồ sơ creator nguyên văn: chân dung follower, tỷ trọng GMV theo kênh / ngành...

  kl           String?   // cấp KOL KL1–KL7 nhập tay; trống thì dùng klAuto
  // Gộp từ booking trên Lark mỗi lượt đồng bộ (refreshKocAggregates)
  klAuto        String?
  bookingCount  Int       @default(0)
  lastBookingAt DateTime?
  // Nhận hàng mẫu
  receiverName  String?
  receiverPhone String?
  address       String?
  // Thanh toán: chỉ Admin / Leader xem, không bao giờ xuất cho Brand
  bankHolder    String?
  bankAccount   String?
  bankName      String?
  idNumber      String?  // CCCD / MST

  listingItems ListingItem[]
  snapshots    KocSnapshot[]
  notes        KocNote[]
  jobs         Job[]
  aliases      KocAlias[]
  tags            String[] @default([]) // nhãn nội bộ, vd "Giao hàng chậm", "Hợp brand mẹ bé"
  blacklisted     Boolean  @default(false) // không book nữa: ẩn khỏi Creator matching
  blacklistReason String?

  // Tab Danh bạ KOC / KOL theo bản chốt trên app b2c (src/lib/kocDirectory.ts)
  category      String?  // Ngành hàng (9 nhóm KOC_CATEGORIES); null = Chưa phân loại
  readiness     String?  // KOC mới: SẴN_SÀNG_BOOKING / TIẾP_CẬN_BỔ_SUNG_PHÁP_LÝ / CẦN_XIN_LIÊN_HỆ / CHỜ_TIẾP_CẬN (null)
  contactStatus String?  // KOC mới: CHƯA_LIÊN_HỆ / ĐÃ_LIÊN_HỆ / ĐANG_THƯƠNG_LƯỢNG / TỪ_CHỐI
  coopConfirmed Boolean  @default(false) // "Chốt hợp tác": vào tab KOC đã hợp tác dù chưa có booking
  channels      KocChannel[]
  legalProfiles KocLegalProfile[]
  ratings       KocRating[]
  reviews       KocReview[]
  candidates    MatchCandidate[]

  @@unique([platform, handle])
  @@index([niche])
  @@index([followers])
  @@index([unitsSold])
}

// Bản sao chỉ đọc của bảng "3.2 List duyệt book" trên Lark Base, đồng bộ mỗi giờ (src/lib/bookingSync.ts).
model Booking {
  id            String    @id // record_id trên Lark
  code          String    // Mã Booking (BO...)
  channel       String?   // 🎃 id kênh
  channelUrl    String?
  store         String?
  brand         String?
  owner         String?   // Người phụ trách
  pipeline      String?
  planMonth     String?   // "2026/03"
  airDate       DateTime? // Ngày air/live real
  planAirDate   DateTime? // P.Ngày air
  cost          Float?    // Chi phí thanh toán Booking, VND
  linkAir       String?
  slaLate       Boolean   @default(false) // Lark "Cảnh báo trễ SLA" = Trễ hạn
  paymentStatus String?   // Trạng thái phiếu thanh toán (Under Review, Rejected...)
  planShipDate     DateTime?
  planReceiveDate  DateTime?
  planScriptDate   DateTime?
  planDemoDate     DateTime?
  planPaymentDate  DateTime? // P.Ngày làm ĐNTT
  bookingPic    String?
  accountPic    String?
  leader        String?
  syncVersion   Int       @default(0)
  extra         Json      // các cột phụ: sản phẩm, tệp kênh, nền tảng, KL, views/GMV 30 ngày...
  larkUpdatedAt DateTime  // last_modified_time của Lark, để chỉ ghi bản ghi mới/đã sửa
  syncedAt      DateTime  @updatedAt

  @@index([planMonth])
  @@index([brand])
  @@index([pipeline])
  @@index([owner])
  @@index([code])
  @@index([slaLate])
  @@index([airDate])
  @@index([planAirDate])
}

model SyncState {
  id         String    @id // "bookings"
  startedAt  DateTime?
  finishedAt DateTime?
  message    String?
  data       Json? // kết quả job, vd. thống kê tab Dữ liệu
}

// Đợt listing: danh sách KOC đề xuất cho Brand duyệt (thay file "Excel Listing").
model ListingBatch {
  id          String        @id @default(cuid())
  name        String        // "pH Care – T11 – Đợt 1"
  brand       String?
  store       String?
  product     String?
  month       String        // "2026-11"
  cr          Float?        // tỷ lệ chuyển đổi SP theo gian hàng, 0.05 = 5%
  aov         Int?          // AOV sản phẩm theo gian hàng, VND
  planLineId  String?       // đợt tạo từ matching của một dòng plan: job tạo từ đợt này gắn về dòng plan đó
  briefId     String?       // đợt tạo ở bước 9 của Creator matching (MatchBrief.id)
  sheetUrl    String?       // Google Sheet của brand đã đẩy listing (G1); kết quả duyệt đọc lại từ đây (G2)
  sheetAt     DateTime?     // lần đẩy gần nhất
  shareToken  String?       // link Brand duyệt /review/<token>; null = chưa tạo hoặc đã thu hồi. Index thường, không @unique: thêm unique
                            // vào bảng có sẵn khiến `prisma db push` trên Render dừng đòi --accept-data-loss; token ngẫu nhiên 144 bit.
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  items       ListingItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([month])
  @@index([shareToken])
}

// Một KOC trong đợt listing. Số liệu kênh (follower, GPM, chân dung...) đọc trực tiếp từ Koc, không chép vào đây.
// ID kênh khác của cùng một KOC (Lark ghi "chengtom2", "Cheng Tôm"... cho "chengtom02"). Gộp ở Danh bạ tạo alias;
// đồng bộ Lark đổi booking có ID này sang handle của KOC đã gộp nên mọi thống kê theo booking vẫn khớp.
model KocAlias {
  handle    String   @id // chữ thường, như Koc.handle
  kocId     String
  koc       Koc      @relation(fields: [kocId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([kocId])
}

model ListingItem {
  jobs           Job[]
  id             String       @id @default(cuid())
  batchId        String
  batch          ListingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  kocId          String
  koc            Koc          @relation(fields: [kocId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  priceType      String       @default("Video")
  price          Int?         // giá net đề xuất cho đợt này, VND (1 video / 1 phiên)
  videos         Int          @default(1) // số video / phiên KOC làm trong đợt: Tạo job sinh đủ số job này
  status         String?      // trạng thái liên hệ
  recommendation String?      // Must Have / Recommend / Optional
  contentNote    String?
  brandChoice    String?      // Yes / No / Cân nhắc
  rejectReason   String?
  planAirDate    DateTime?
  invitedAt      DateTime?    // đã gửi mail mời hợp tác (L6)
  viewTarget     Int?         // nhập tay khi cần (KL6–KL7, hoặc chưa có số TikTok)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([batchId, kocId])
}

// Hiệu quả của từng KOL Danh bạ trong từng bảng của Trạm dữ liệu (tab Dữ liệu, hồ sơ KOC).
// m theo thứ tự chỉ số của nguồn trong src/lib/dataSources.ts. Job data-sources ghi đè cả nguồn mỗi lần chạy.
model CreatorMetric {
  source    String
  handle    String
  m         Float[]
  shops     Json?    // [{ key, shop, m }]: tách theo shop / brand / sản phẩm của nguồn, 20 shop lớn nhất
  updatedAt DateTime @default(now())

  @@id([source, handle])
  @@index([handle])
}

// Chỉ số Creator Marketplace mỗi lần tra thành công, để xem xu hướng (src/lib/creatorStats.ts).
model KocSnapshot {
  id           String   @id @default(cuid())
  kocId        String
  koc          Koc      @relation(fields: [kocId], references: [id], onDelete: Cascade)
  at           DateTime @default(now())
  followers    Int?
  avgViews     Int?
  avgLiveViews Int?
  unitsSold    Int?
  gmvRange     String?
  gpmUsd       Float?

  @@index([kocId, at])
}

// Nhật ký chăm sóc KOL; followUpAt = hẹn liên hệ lại, doneAt = đã xử lý hẹn.
model KocNote {
  id         String    @id @default(cuid())
  kocId      String
  koc        Koc       @relation(fields: [kocId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  channel    String?   // kênh liên hệ (Zalo / TikTok DM / Email / Điện thoại / Lark), ghi từ "Ghi lịch sử liên hệ"
  followUpAt DateTime?
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([kocId, createdAt])
  @@index([followUpAt])
}

// Creator matching: một đợt booking theo 10 bước của "Tổng hợp tiêu chí chuẩn hóa – AI Creator Matching (v0.1)".
// Khối 1–3 (brand, SKU, quy tắc lọc) nằm ở Brand / Product; bản ghi này giữ Khối 4 (kế hoạch và brief của đợt).
// template, criteria: bộ lọc cũ (trước 10 bước), giữ cột để không mất dữ liệu, app không dùng nữa.
model MatchBrief {
  id          String   @id @default(cuid())
  name        String
  template    Boolean  @default(false)
  category    String?  // ngành hàng
  brand       String?
  guideline   String?  // Brand guideline: link tài liệu + ghi chú
  strategy    String?  // Content strategy
  plan        String?  // Content plan
  note        String?  // ghi chú
  criteria    Json     @default("{}")
  brandId     String?
  brandRef    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  planLineId  String?
  planLine    PlanLine? @relation(fields: [planLineId], references: [id], onDelete: SetNull)
  // Khối 4. Kế hoạch và brief đợt booking (I-28 – I-38)
  productId      String?   // I-28 SKU cần book
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  dealPrice      Int?      // I-29 giá deal, VND
  aov            Int?      // I-29 AOV gian hàng lúc book, VND
  objective      String    @default("Convert") // I-30 Convert / Awareness
  gmvMax         Boolean   @default(false)     // brand chạy GMV Max (K14), tách khỏi mục tiêu theo mục 5.3.3
  channel        String    @default("TikTok")  // I-31 TikTok / Shopee / FB-IG / Threads
  slots          Json      @default("[]")      // I-32 [{ kl, role, count }]
  budget         Int?      // I-33 tổng ngân sách đợt, VND
  feeCap         Int?      // I-33 trần fee mỗi KOC, VND
  airMonth       String?   // I-34 "2026-12"
  airWeek        Int?      // I-34 tuần 1–5
  format         String?   // I-35 format và thời lượng video
  includeHandles String[]  @default([]) // I-36 KOC brand chỉ định
  excludeHandles String[]  @default([]) // I-36 KOC brand cấm
  gmvTarget      Int?      // I-37
  crTarget       Float?    // I-37, 0.05 = 5%
  ctrTarget      Float?    // I-37
  expertClaim    Boolean   @default(false) // nội dung có claim chuyên môn: bật K12
  ranAt          DateTime? // lần chạy matching gần nhất (bước 2–3)
  runNote        String?
  candidates     MatchCandidate[]
  decisions   MatchDecision[]
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([template, updatedAt])
}

// Một KOC / creator trong một đợt matching, đi qua các bước 2–10. handle + platform thay vì chỉ kocId vì pool gồm cả
// creator trong kho dữ liệu chưa có ở Danh bạ; khi vào shortlist app tạo KOC ở Danh bạ và gắn kocId.
model MatchCandidate {
  id           String    @id @default(cuid())
  briefId      String
  brief        MatchBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  platform     String    @default("TikTok")
  handle       String    // chữ thường, không @
  kocId        String?
  koc          Koc?      @relation(fields: [kocId], references: [id], onDelete: SetNull)
  stage        String    @default("POOL") // src/lib/matching/spec.ts STAGES
  kl           String?   // cấp KOL dùng khi chấm (Danh bạ, hoặc suy theo follower)
  data         Json      @default("{}") // số liệu đã dùng để chấm + nguồn
  knockouts    Json      @default("[]") // bước 3, tự động: [{ code, detail }]
  flags        Json      @default("[]") // cảnh báo, thiếu số liệu: [{ code, detail }]
  checks       Json      @default("{}") // bước 4, Booker kiểm tra: { K1: { ok, note, by, at } }
  declare      Json      @default("{}") // bước 6, KOC khai báo: giá, ads code, cam kết, chứng chỉ...
  manual       Json      @default("{}") // điểm Booker chấm tay: { critId: { score, note } }
  score        Json?     // { groups, total, coverage, tier, mustFail }
  total        Float?
  tier         String?
  rejectCode   String?   // mã K (hoặc nhóm điểm thấp) khi loại
  reason       String?
  exception    String?   // giữ lại dù bị loại tự động: lý do + người duyệt ngoại lệ (I-26)
  approvedById String?
  approvedAt   DateTime?
  outcome      Json?     // bước 10: kết quả sau air + quyết định
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([briefId, platform, handle])
  @@index([briefId, stage])
  @@index([handle])
  @@index([kocId])
}

// Số liệu creator lấy từ kho dữ liệu (ClickHouse, bảng kol-connector connector_creator_public_*), đồng bộ bằng job
// sync-creators (src/lib/warehouse/creatorSync.ts). Là pool "Marketplace" ở bước 2; KOC Danh bạ cùng handle đọc số từ đây.
model WarehouseCreator {
  platform    String    // TikTok / Shopee / Facebook / Instagram / Threads / YouTube
  handle      String    // username chữ thường
  nickname    String?
  avatarUrl   String?
  url         String?
  followers   Int?
  medianViews Int?      // avg_video_play_count: trung vị lượt xem mọi video (crawler)
  ecViews     Int?      // avg_ec_video_play_count: lượt phát TB video gắn sản phẩm
  liveViews   Int?      // avg_ec_live_view_count: lượt xem TB phiên LIVE bán hàng
  er          Float?    // video_engagement_rate, 0.05 = 5%
  videos30    Int?      // video_count_30d
  ecVideos    Int?      // ec_video_count
  unitsSold   Int?
  gmv         Float?    // GMV affiliate 30 ngày, VND; KOC ẩn GMV thì lấy trung điểm khoảng
  gmvHidden   Boolean   @default(false)
  gpm         Float?    // VND / 1.000 lượt xem
  aov         Float?    // GMV trung bình / người mua, VND
  female      Float?    // 0..1
  male        Float?    // 0..1
  ages        Json?     // { "18-24": 0.3, "25-34": ..., "35-44", "45-54", "55+" } 0..1
  locations   Json?     // [{ name, share }] 0..1
  categories  Json?     // [{ name, share }] tỷ trọng GMV theo ngành, 0..1
  gmvMix      Json?     // { video, live, showcase } tỷ trọng GMV theo kênh bán, 0..1
  brandCount  Int?
  brands      String[]  @default([])
  products    Int?      // promoted_product_num
  castFee     Int?      // latest_cast_fee, VND
  fulfillment Float?    // score: điểm hoàn thành hợp tác 90 ngày
  mcn         String?
  topVideos   Json?     // [{ title, url, views, likes, date, products }]
  sourceAt    DateTime? // last_synced_at bên kho
  syncedAt    DateTime  @default(now())

  @@id([platform, handle])
  @@index([followers])
  @@index([gmv])
}

// Bảng xếp hạng tính sẵn cho tab Dữ liệu (job data-sources): trang đọc DB, không hỏi Trạm lúc mở trang.
// kind: "top" (top creator theo từng chỉ số), "shops" (theo shop), "shop:<key>" (top creator của một shop).
model SourceCache {
  source    String
  kind      String
  data      Json
  updatedAt DateTime @default(now())

  @@id([source, kind])
}

// ---------------------------------------------------------------- Master data
model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  logoUrl   String?
  usp       String?  // điểm bán hàng chính
  guideline String?  // brand guideline: link tài liệu + điểm chính (tone, từ cấm, claim được phép)
  checklist String?  // tiêu chí nghiệm thu video, mỗi dòng một tiêu chí; trống = checklist mặc định
  keywords  String?  // từ khoá / hashtag bắt buộc trong caption video, cách nhau dấu phẩy (kiểm tra tự động khi nghiệm thu)
  note      String?
  // Khối 1. Brand Profile (Creator matching)
  category     String?  // I-02 ngành hàng, khớp tên ngành trong tỷ trọng GMV của creator
  subCategory  String?  // I-02 ngành con theo phân loại UpBase (K7)
  group        String?  // I-03 nhóm brand / tập đoàn (K7)
  audience     String?  // I-04 TA chính: giới tính, tuổi, khu vực, insight
  tone         String?  // I-05 mood & tone
  rtb          String?  // I-07 RTB và claim được phép
  bannedClaims String[] @default([]) // I-07 claim / từ bị cấm (K4)
  competitors  String[] @default([]) // I-08 đối thủ cùng công dụng (K8)
  rules        Json     @default("{}") // Khối 3: I-09, I-19 – I-27, I-56 (src/lib/matching/spec.ts BrandRules)
  stores    Store[]
  products  Product[]
  members   BrandMember[]
  planLines PlanLine[]
  jobs      Job[]
  briefs    MatchBrief[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store { // gian hàng
  id       String    @id @default(cuid())
  brandId  String
  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name     String
  platform String    @default("TikTok Shop")
  url      String?
  cr       Float?    // tỷ lệ chuyển đổi sản phẩm theo gian hàng, 0.05 = 5%
  aov      Int?      // giá trị đơn trung bình, VND
  products Product[]

  @@unique([brandId, name])
}

model Product {
  id        String     @id @default(cuid())
  brandId   String
  brand     Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  storeId   String?
  store     Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  name      String
  imageUrl  String?
  usp       String?
  price     Int?
  link      String?
  // Khối 2. SKU Config (Creator matching)
  sku          String?  // I-10 mã SP
  line         String?  // I-10 dòng SP
  targetGender String?  // I-12 Nữ / Nam; trống = mọi giới
  ageMin       Int?     // I-12 độ tuổi mục tiêu
  ageMax       Int?
  kocVisual    String?  // I-13 chân dung và visual bắt buộc của KOC
  problem      String?  // vấn đề sản phẩm giải quyết (nhóm 0 "Trải nghiệm thật", mục 5.3.1 #11)
  exclusions   String[] @default([]) // I-14 trường hợp loại (K11)
  channelTypes String[] @default([]) // I-15 tệp kênh ưu tiên
  bannedWords  String[] @default([]) // I-16 từ cấm riêng của SKU (K4)
  femaleMin    Float?   // I-17 % follower nữ tối thiểu, 0–100 (K10)
  age18_34Min  Float?   // I-17 % follower 18–34 tối thiểu, 0–100 (K10)
  regions      String[] @default([]) // I-17 khu vực mục tiêu
  regionMin    Float?   // I-17 % follower tại khu vực tối thiểu, 0–100
  reviewerId   String?  // I-18 PIC duyệt content (User.id)
  planLines PlanLine[]
  jobs      Job[]
  briefs    MatchBrief[]
}

model TierPrice { // bảng giá booking theo tier KOC
  id        String  @id @default(cuid())
  tier      String  // KL1–KL7
  priceType String  // Video, Phiên livestream...
  minPrice  Int?
  maxPrice  Int?
  note      String?

  @@unique([tier, priceType])
}

model BrandMember { // nhân sự phụ trách brand
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    String // Booking PIC / Booking Support / Brand Manager

  @@id([brandId, userId, role])
}

// ---------------------------------------------------------------- Plan
model Plan {
  id          String     @id @default(cuid())
  name        String
  month       String     // "2026-12"
  budget      Int?
  note        String?
  createdById String
  lines       PlanLine[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([month])
}

model PlanLine { // plan chi tiết: brand × tuần × tier × loại content
  id          String       @id @default(cuid())
  planId      String
  plan        Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  brandId     String?
  brand       Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  week        Int?         // tuần 1–5 của tháng
  tier        String?      // KL1–KL7
  contentType String       @default("Video")
  quantity    Int          @default(1)
  budget      Int?
  picId       String?
  pic         User?        @relation(fields: [picId], references: [id], onDelete: SetNull)
  note        String?
  briefs      MatchBrief[]
  jobs        Job[]
}

// ---------------------------------------------------------------- Matching
model MatchDecision { // chọn / loại KOC trong một brief; loại bắt buộc có lý do
  briefId  String
  brief    MatchBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  kocId    String
  decision String     // pick | reject
  reason   String?
  byId     String
  at       DateTime   @default(now())

  @@id([briefId, kocId])
}

// ---------------------------------------------------------------- Job (booking quản lý trong app)
model Job {
  id            String          @id @default(cuid())
  number        Int             @unique @default(autoincrement())
  kocId         String
  koc           Koc             @relation(fields: [kocId], references: [id])
  brandId       String?
  brand         Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  productId     String?
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  planLineId    String?
  planLine      PlanLine?       @relation(fields: [planLineId], references: [id], onDelete: SetNull)
  listingItemId String?
  listingItem   ListingItem?    @relation(fields: [listingItemId], references: [id], onDelete: SetNull)
  picId         String?
  pic           User?           @relation(fields: [picId], references: [id], onDelete: SetNull)
  stage         String          @default("Đã duyệt") // src/lib/jobs.ts STAGES
  priceType     String          @default("Video")
  price         Int?            // giá net
  deadline      DateTime?       // hạn air
  sample        String?         // hàng mẫu: Cần gửi / Đã gửi / KOC đã nhận / Đã hoàn / Không cần
  brief         String?
  briefApproved Boolean         @default(false)
  submittedUrl  String?         // link video KOC nộp
  submittedAt   DateTime?
  review        Json?           // [{ item, result, at, note }] theo checklist nghiệm thu
  reviewResult  String?         // Đạt / Cần sửa / Không đạt
  reviewNote    String?
  reviewedById  String?
  reviewedAt    DateTime?
  autoCheck     Json?           // kiểm tra tự động link nộp: [{ check, status PASS/WARN/FAIL, detail }] + at
  paymentId     String?
  payment       PaymentRequest? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  note          String?
  createdById   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([stage])
  @@index([brandId])
  @@index([picId])
  @@index([listingItemId])
}

model PaymentRequest { // đề nghị thanh toán (ĐNTT) gom từ job đã nghiệm thu đạt
  id          String   @id @default(cuid())
  number      Int      @unique @default(autoincrement())
  status      String   @default("Nháp") // Nháp / Đã gửi duyệt / Đã duyệt / Đã thanh toán
  approvalCode   String?  // instance_code trên Lark Approval (L4); null = chưa gửi qua Lark
  approvalStatus String?  // PENDING / APPROVED / REJECTED / CANCELED / DELETED đọc lại từ Lark (L5)
  note        String?
  createdById String
  jobs        Job[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog { // lịch sử thay đổi
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  userId   String?
  entity   String   // Job, Plan, Brand...
  entityId String
  action   String
  detail   Json?

  @@index([entity, entityId])
}

// Kênh khác của KOC: TikTok phụ và Shopee / Facebook / Instagram / Threads. Kênh TikTok chính là Koc.handle (khớp booking Lark).
model KocChannel {
  id        String   @id @default(cuid())
  kocId     String
  koc       Koc      @relation(fields: [kocId], references: [id], onDelete: Cascade)
  platform  String   // TikTok / Shopee / Facebook / Instagram / Threads
  handle    String   // chữ thường, không @
  role      String?  // TikTok phụ: TIKTOK_ROLES
  createdAt DateTime @default(now())

  @@unique([kocId, platform, handle])
  @@index([platform, handle])
}

// Hồ sơ pháp lý (1 KOC → N pháp nhân thụ hưởng). Hồ sơ mặc định được chép ngược vào Koc.bankHolder / bankAccount /
// bankName / idNumber để ĐNTT, listing, job dùng như cũ. KOC chưa có hồ sơ: hiển thị HSPL-01 dựng từ các cột đó.
model KocLegalProfile {
  id                  String    @id @default(cuid())
  kocId               String
  koc                 Koc       @relation(fields: [kocId], references: [id], onDelete: Cascade)
  code                String    // HSPL-01, HSPL-02...
  legalType           String    // INDIVIDUAL / HOUSEHOLD / COMPANY
  isDefault           Boolean   @default(false)
  status              String    @default("PENDING_VERIFY") // ACTIVE / PENDING_VERIFY / ARCHIVED
  taxAccountType      String?   // chế độ khấu trừ thuế
  signRole            String?   // vai trò ký kết
  holderName          String
  cccd                String?
  cccdIssueDate       String?   // DD/MM/YYYY
  cccdIssuePlace      String?
  taxCode             String?
  businessLicenseNo   String?
  representativeName  String?
  representativeTitle String?
  authorizationNumber String?
  authorizationDate   String?
  vatRatePercent      Float?
  contactPhone        String?
  contactEmail        String?
  address             String?   // thường trú (cá nhân) / trụ sở đăng ký (HKD, công ty)
  bankName            String?
  bankAccount         String?
  bankHolderName      String?   // IN HOA KHÔNG DẤU
  notes               String?
  contractStatus      String?   // HĐNT: CHƯA_KÝ / ĐANG_TRÌNH_KÝ / ĐÃ_KÝ / HẾT_HẠN
  contractCode        String?
  contractSignedAt    DateTime?
  contractUrl         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([kocId, code])
  @@index([cccd])
  @@index([taxCode])
}

// Đánh giá sao sau deal: mỗi deal một lượt (mã BO trên Lark hoặc mã job trong app), người chấm hoặc người có quyền sửa KOC được sửa.
model KocRating {
  id          String   @id @default(cuid())
  dealId      String   @unique
  kocId       String
  koc         Koc      @relation(fields: [kocId], references: [id], onDelete: Cascade)
  brand       String?
  stars       Int      // 1–5
  tags        String[] @default([]) // mã nhận định RATING_TAGS
  note        String?
  evaluatorId String?
  evaluator   User?    @relation(fields: [evaluatorId], references: [id], onDelete: SetNull)
  evaluatedAt DateTime @default(now())

  @@index([kocId])
}

// Đánh giá kênh theo brand: Phù hợp / Cân nhắc / Không phù hợp. Nhật ký chỉ thêm, nhiều lượt cho mỗi brand.
model KocReview {
  id         String   @id @default(cuid())
  kocId      String
  koc        Koc      @relation(fields: [kocId], references: [id], onDelete: Cascade)
  verdict    String   // SUITABLE / CAUTION / NOT_SUITABLE
  reasons    String[] @default([])
  note       String
  brand      String   // tên brand hoặc "Toàn hệ thống B2C"
  source     String   @default("Danh bạ KOC")
  reviewerId String?
  reviewer   User?    @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([kocId, createdAt])
  @@index([verdict])
}
