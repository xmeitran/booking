datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN  // quản lý user + toàn quyền
  LEADER // sửa mọi booking & danh bạ
  STAFF  // sửa booking mình phụ trách, xem danh bạ
}

model User {
  id          String    @id @default(cuid())
  larkUserId  String    @unique // user_id (hoặc open_id ou_...) của tài khoản Lark
  // Lấy từ Lark khi Admin thêm user và mỗi lần đăng nhập, không sửa tay.
  name        String?
  email       String?
  avatarUrl   String?
  department  String?
  jobTitle    String?
  role        Role      @default(STAFF)
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  kocs        Koc[]
}

model Koc {
  id         String   @id @default(cuid())
  platform   String   @default("TikTok")
  handle     String   // @username, không gồm @
  name       String   // tên kênh
  channelUrl String?
  followers  Int?
  niche      String?  // tệp kênh
  phone      String?
  zalo       String?
  email      String?
  rateCard   Int?     // giá tham khảo / video, VND
  note       String?
  picId      String?
  pic        User?    @relation(fields: [picId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([platform, handle])
  @@index([niche])
}

// Bản sao chỉ đọc của bảng "3.2 List duyệt book" trên Lark Base, đồng bộ mỗi giờ (src/lib/bookingSync.ts).
model Booking {
  id            String    @id // record_id trên Lark
  code          String    // Mã Booking (BO...)
  channel       String?   // 🎃 id kênh
  channelUrl    String?
  store         String?
  brand         String?
  owner         String?   // Người phụ trách
  pipeline      String?
  planMonth     String?   // "2026/03"
  airDate       DateTime? // Ngày air/live real
  planAirDate   DateTime? // P.Ngày air
  cost          Float?    // Chi phí thanh toán Booking, VND
  linkAir       String?
  extra         Json      // các cột phụ: sản phẩm, tệp kênh, nền tảng, KL, views/GMV 30 ngày...
  larkUpdatedAt DateTime  // last_modified_time của Lark, để chỉ ghi bản ghi mới/đã sửa
  syncedAt      DateTime  @updatedAt

  @@index([planMonth])
  @@index([brand])
  @@index([pipeline])
  @@index([owner])
  @@index([code])
}

model SyncState {
  id         String    @id // "bookings"
  startedAt  DateTime?
  finishedAt DateTime?
  message    String?
}
